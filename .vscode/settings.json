{
    "nix.enableLanguageServer": true,
    "nix.serverPath": "nixd",
    "nix.formatterPath": "nixfmt",
    "nix.serverSettings": {
        "nixd": {
            "formatting": {
                "command": [
                    "nixfmt"
                ],
            },
            "options": {
                "home-manager": {
                    "expr": "(builtins.getFlake (toString ./.)).homeConfigurations.gingdev.options",
                },
            },
        }
    }
}